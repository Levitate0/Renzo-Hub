<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark by default, not only in drawable-night.

  The Hub mark carries a WHITE torii inside the enso. On the pale gradient this
  file used to hold (inherited from the Shiori icon set) that torii disappears
  completely — white on near-white. The mark is drawn for a dark ground, which
  is how the supplied banner art presents it, so the launcher background stays
  dark under both light and dark system themes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:startColor="#161226" android:endColor="#0A0A12" android:angle="135" />
</shape>
